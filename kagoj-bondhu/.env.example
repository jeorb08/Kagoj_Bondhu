PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EXPLAIN_MODEL=
AI_EXPLANATIONS=1
AI_TIMEOUT_SECONDS=60

# Use device speech while testing photo reading.
TTS_PROVIDER=browser
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore

MOCK_EXTRACTION=0
CACHE_EXTRACTION=0
RATE_LIMIT_PER_HOUR=120
ALLOWED_ORIGINS=
OMP_NUM_THREADS=2
PORT=8000

